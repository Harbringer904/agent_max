# Optional but recommended — without it you get 60 req/hour (vs 5000 with it)
# Get one free at https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# Optional — enables the "Google Places" provider: real local businesses/professionals
# for ANY field + ANY city (not just tech). Requires a Google Cloud project with billing
# enabled to issue the key (console.cloud.google.com -> APIs & Services -> Places API (New)).
# Places Text Search has a monthly free-usage credit that normal use stays within, but a
# card must be on file. Without this key, the provider silently returns no results.
# GOOGLE_PLACES_API_KEY=

# Optional — enables "🧠 AI reasoning" scoring. Only ONE of the three keys below is needed;
# if more than one is set, priority is ANTHROPIC_API_KEY > GROQ_API_KEY > GEMINI_API_KEY
# (override with LLM_PROVIDER=anthropic|groq|gemini). Without any of them, search silently
# falls back to the deterministic rules-based scorer.
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=          # free — sign up at https://console.groq.com
# GEMINI_API_KEY=        # free — sign up at https://aistudio.google.com
# LLM_PROVIDER=anthropic

# Server port (default 3000)
PORT=3000
